{
  "doctype": "DocType",
  "name": "DoubleT Pricing Settings",
  "module": "DoubleT CRM",
  "issingle": 1,
  "engine": "InnoDB",
  "field_order": [
    "default_price_list",
    "enable_discount_approval",
    "discount_approval_threshold_percent",
    "discount_approval_threshold_amount"
  ],
  "fields": [
    {
      "fieldname": "default_price_list",
      "fieldtype": "Link",
      "label": "Default Price List",
      "options": "DoubleT Price List"
    },
    {
      "fieldname": "enable_discount_approval",
      "fieldtype": "Check",
      "label": "Enable Discount Approval",
      "default": "0"
    },
    {
      "fieldname": "discount_approval_threshold_percent",
      "fieldtype": "Float",
      "label": "Discount Approval Threshold (%)",
      "default": "0"
    },
    {
      "fieldname": "discount_approval_threshold_amount",
      "fieldtype": "Currency",
      "label": "Discount Approval Threshold (USD)",
      "precision": "2",
      "default": "0"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1
    },
    {
      "role": "Sales Manager",
      "read": 1
    },
    {
      "role": "Sales User",
      "read": 1
    }
  ]
}
