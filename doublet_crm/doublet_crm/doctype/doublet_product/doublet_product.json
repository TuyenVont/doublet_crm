
{
  "doctype": "DocType",
  "name": "DoubleT Product",
  "module": "DoubleT CRM",
  "autoname": "field:sku",
  "engine": "InnoDB",
  "field_order": [
    "product_name",
    "sku",
    "product_kind",
    "variant_of",
    "category",
    "categories",
    "variant_attributes",
    "variant_signature",
    "variant_key",
    "price",
    "description",
    "is_active"
  ],
  "fields": [
    {
      "fieldname": "product_name",
      "fieldtype": "Data",
      "label": "Product Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sku",
      "fieldtype": "Data",
      "label": "SKU",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "product_kind",
      "fieldtype": "Select",
      "label": "Product Kind",
      "options": "Standard\nTemplate\nVariant",
      "default": "Standard",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "variant_of",
      "fieldtype": "Link",
      "label": "Variant Of",
      "options": "DoubleT Product"
    },
    {
      "fieldname": "category",
      "fieldtype": "Link",
      "label": "Category",
      "options": "DoubleT Product Category",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "categories",
      "fieldtype": "Table",
      "label": "Categories",
      "options": "DoubleT Product Category Assignment"
    },
    {
      "fieldname": "variant_attributes",
      "fieldtype": "Table",
      "label": "Variant Attributes",
      "options": "DoubleT Product Variant Attribute"
    },
    {
      "fieldname": "variant_signature",
      "fieldtype": "Small Text",
      "label": "Variant Signature",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "variant_key",
      "fieldtype": "Data",
      "label": "Variant Key",
      "read_only": 1,
      "hidden": 1,
      "unique": 1
    },
    {
      "fieldname": "price",
      "fieldtype": "Currency",
      "label": "Price",
      "default": "0",
      "reqd": 1,
      "in_list_view": 1,
      "precision": "2"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Sales Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Sales User",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "title_field": "product_name",
  "search_fields": "product_name,sku",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1
}
