
{
  "doctype": "DocType",
  "name": "DoubleT Product",
  "module": "DoubleT CRM",
  "autoname": "field:sku",
  "engine": "InnoDB",
  "field_order": [
    "product_name",
    "sku",
    "category",
    "price",
    "description",
    "is_active"
  ],
  "fields": [
    {
      "fieldname": "product_name",
      "fieldtype": "Data",
      "label": "Product Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sku",
      "fieldtype": "Data",
      "label": "SKU",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "fieldtype": "Link",
      "label": "Category",
      "options": "DoubleT Product Category",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "price",
      "fieldtype": "Currency",
      "label": "Price",
      "default": "0",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Sales Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Sales User",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "title_field": "product_name",
  "search_fields": "product_name,sku",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1
}
