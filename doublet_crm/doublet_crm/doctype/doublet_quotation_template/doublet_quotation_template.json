{
 "doctype": "DocType",
 "name": "DoubleT Quotation Template",
 "module": "DoubleT CRM",
 "autoname": "field:template_name",
 "engine": "InnoDB",
 "track_changes": 1,
 "title_field": "template_name",
 "search_fields": "template_name,product_category",
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "template_name",
  "product_category",
  "is_active",
  "description",
  "terms",
  "items"
 ],
 "fields": [
  {
   "fieldname": "template_name",
   "fieldtype": "Data",
   "label": "Template Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "product_category",
   "fieldtype": "Link",
   "label": "Product / Service Group",
   "options": "DoubleT Product Category",
   "in_list_view": 1
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "terms",
   "fieldtype": "Small Text",
   "label": "Terms & Conditions"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "DoubleT Quotation Template Item",
   "reqd": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "create": 1,
   "write": 1,
   "delete": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "create": 1,
   "write": 1,
   "delete": 1
  },
  {
   "role": "Sales User",
   "read": 1
  }
 ]
}
