{
 "doctype": "DocType",
 "name": "DoubleT Quotation",
 "module": "DoubleT CRM",
 "autoname": "naming_series:",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": ["naming_series", "deal", "customer_type", "contact", "company", "price_list", "quotation_template", "quotation_date", "valid_until", "status", "approval_status", "approval_requested_by", "approval_requested_on", "approved_by", "approved_on", "rejection_reason", "approval_snapshot_hash", "items", "subtotal", "total_discount", "grand_total", "terms", "notes"],
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "QUO-.#####", "default": "QUO-.#####", "reqd": 1, "hidden": 1},
  {"fieldname": "deal", "fieldtype": "Link", "label": "Deal", "options": "DoubleT Deal"},
  {"fieldname": "customer_type", "fieldtype": "Select", "label": "Customer Type", "options": "\nPERSONAL\nCOMPANY", "reqd": 1},
  {"fieldname": "contact", "fieldtype": "Link", "label": "Contact", "options": "DoubleT Contact"},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "DoubleT Company"},
  {"fieldname": "price_list", "fieldtype": "Link", "label": "Price List", "options": "DoubleT Price List"},
  {"fieldname": "quotation_template", "fieldtype": "Link", "label": "Quotation Template", "options": "DoubleT Quotation Template"},
  {"fieldname": "quotation_date", "fieldtype": "Date", "label": "Quotation Date", "reqd": 1},
  {"fieldname": "valid_until", "fieldtype": "Date", "label": "Valid Until", "reqd": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nSent\nAccepted\nRejected", "default": "Draft", "reqd": 1, "in_list_view": 1},
  {"fieldname": "approval_status", "fieldtype": "Select", "label": "Approval Status", "options": "Not Required\nRequired\nPending\nApproved\nRejected", "default": "Not Required", "read_only": 1, "in_list_view": 1},
  {"fieldname": "approval_requested_by", "fieldtype": "Link", "label": "Approval Requested By", "options": "User", "read_only": 1},
  {"fieldname": "approval_requested_on", "fieldtype": "Datetime", "label": "Approval Requested On", "read_only": 1},
  {"fieldname": "approved_by", "fieldtype": "Link", "label": "Approved / Rejected By", "options": "User", "read_only": 1},
  {"fieldname": "approved_on", "fieldtype": "Datetime", "label": "Approved / Rejected On", "read_only": 1},
  {"fieldname": "rejection_reason", "fieldtype": "Small Text", "label": "Rejection Reason", "read_only": 1},
  {"fieldname": "approval_snapshot_hash", "fieldtype": "Data", "label": "Approval Snapshot Hash", "read_only": 1, "hidden": 1},
  {"fieldname": "items", "fieldtype": "Table", "label": "Items", "options": "DoubleT Quotation Item", "reqd": 1},
  {"fieldname": "subtotal", "fieldtype": "Currency", "label": "Subtotal", "precision": "2", "read_only": 1},
  {"fieldname": "total_discount", "fieldtype": "Currency", "label": "Total Discount", "precision": "2", "read_only": 1},
  {"fieldname": "grand_total", "fieldtype": "Currency", "label": "Grand Total", "precision": "2", "read_only": 1, "in_list_view": 1},
  {"fieldname": "terms", "fieldtype": "Small Text", "label": "Terms & Conditions"},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "create": 1, "write": 1, "delete": 1},
  {"role": "Sales Manager", "read": 1, "create": 1, "write": 1, "delete": 1},
  {"role": "Sales User", "read": 1, "create": 1, "write": 1}
 ]
}
