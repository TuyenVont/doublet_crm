{
 "doctype": "DocType",
 "name": "DoubleT Quotation",
 "module": "DoubleT CRM",
 "autoname": "naming_series:",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": ["naming_series", "deal", "customer_type", "contact", "company", "quotation_date", "valid_until", "status", "items", "subtotal", "total_discount", "grand_total", "notes"],
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "QUO-.#####", "default": "QUO-.#####", "reqd": 1, "hidden": 1},
  {"fieldname": "deal", "fieldtype": "Link", "label": "Deal", "options": "DoubleT Deal"},
  {"fieldname": "customer_type", "fieldtype": "Select", "label": "Customer Type", "options": "\nPERSONAL\nCOMPANY", "reqd": 1},
  {"fieldname": "contact", "fieldtype": "Link", "label": "Contact", "options": "DoubleT Contact"},
  {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "DoubleT Company"},
  {"fieldname": "quotation_date", "fieldtype": "Date", "label": "Quotation Date", "reqd": 1},
  {"fieldname": "valid_until", "fieldtype": "Date", "label": "Valid Until", "reqd": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nSent\nAccepted\nRejected", "default": "Draft", "reqd": 1, "in_list_view": 1},
  {"fieldname": "items", "fieldtype": "Table", "label": "Items", "options": "DoubleT Quotation Item", "reqd": 1},
  {"fieldname": "subtotal", "fieldtype": "Currency", "label": "Subtotal", "precision": "0", "read_only": 1},
  {"fieldname": "total_discount", "fieldtype": "Currency", "label": "Total Discount", "precision": "0", "read_only": 1},
  {"fieldname": "grand_total", "fieldtype": "Currency", "label": "Grand Total", "precision": "0", "read_only": 1, "in_list_view": 1},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "create": 1, "write": 1, "delete": 1},
  {"role": "Sales Manager", "read": 1, "create": 1, "write": 1, "delete": 1},
  {"role": "Sales User", "read": 1, "create": 1, "write": 1}
 ]
}
