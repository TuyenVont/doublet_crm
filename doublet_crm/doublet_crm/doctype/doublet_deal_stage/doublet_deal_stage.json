{
 "doctype": "DocType",
 "name": "DoubleT Deal Stage",
 "module": "DoubleT CRM",
 "autoname": "field:stage_name",
 "engine": "InnoDB",
 "field_order": [
  "stage_name",
  "sort_order",
  "stage_type",
  "probability_configured",
  "probability",
  "color",
  "enabled"
 ],
 "fields": [
  {
   "fieldname": "stage_name",
   "fieldtype": "Data",
   "label": "Stage Name",
   "reqd": 1,
   "in_list_view": 1,
   "unique": 1
  },
  {
   "fieldname": "sort_order",
   "fieldtype": "Int",
   "label": "Sort Order",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "stage_type",
   "fieldtype": "Select",
   "label": "Stage Type",
   "reqd": 1,
   "in_list_view": 1,
   "options": "OPEN\nWON\nLOST"
  },
  {
   "description": "Optional default for Open Deals in this Stage. A Deal-specific probability takes precedence.",
   "depends_on": "eval:doc.probability_configured",
   "fieldname": "probability",
   "fieldtype": "Percent",
   "label": "Default Close Probability",
   "precision": "2"
  },
  {
   "default": "0",
   "description": "Enable a default probability for Open Deals in this Stage.",
   "fieldname": "probability_configured",
   "fieldtype": "Check",
   "label": "Set Default Close Probability",
   "no_copy": 1
  },
  {
   "fieldname": "color",
   "fieldtype": "Color",
   "label": "Color"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1",
   "in_list_view": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  }
 ],
 "sort_field": "sort_order",
 "sort_order": "ASC",
 "title_field": "stage_name",
 "search_fields": "stage_name,stage_type"
}

