   "reqd": 1
  },
  {
   "fieldname": "contact",
   "fieldtype": "Link",
   "label": "Contact",
   "options": "DoubleT Contact"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "DoubleT Company",
   "in_list_view": 1
  },
  {
   "fieldname": "source_lead",
   "fieldtype": "Link",
   "label": "Source Lead",
